  "tourSettingsTitle": "Réglages",
  "tourSettingsBody": "Heure de Liberté, blocage des applis, routines, rappels et couleurs se règlent ici. Vous pouvez aussi relancer cette visite depuis Réglages.",
  "stepOf": "{current} sur {total}",
  "skipTour": "Passer la visite",
