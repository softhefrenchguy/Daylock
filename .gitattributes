# Portable checkout line endings; the Unix Gradle wrapper must stay executable LF.
* text=auto
*.dart text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.properties text eol=lf
android/gradlew text eol=lf
*.bat text eol=crlf
*.jar binary
*.png binary
*.ico binary
